APP_ENV=development
DATABASE_URL=sqlite:///./data/ai_radar.db
# See 官方RSS源清单.md for a verified no-cost source preset.
RSS_URLS=https://openai.com/news/rss.xml,https://blog.google/technology/ai/rss/,https://deepmind.google/blog/rss.xml,https://mistral.ai/rss.xml,https://huggingface.co/blog/feed.xml,https://aws.amazon.com/blogs/machine-learning/feed/,https://research.google/blog/rss/,https://www.together.ai/blog/rss.xml,https://techcrunch.com/category/artificial-intelligence/feed/,https://www.technologyreview.com/topic/artificial-intelligence/feed/
GITHUB_TOKEN=
X_BEARER_TOKEN=
COMFYUI_URL=
COLLECTION_INTERVAL_MINUTES=120
SCHEDULER_ENABLED=true
HOT_TOPIC_LOOKBACK_DAYS=7
DRAFT_GENERATOR_PROVIDER=template
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Used only by the image-generation action. IMAGE_API_KEY overrides OPENAI_API_KEY.
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
# Startup validates model access. If your API project exposes it instead, set OPENAI_MODEL=gpt-5.5

# Source-quality weights. Set to 0 to exclude a source from heat scoring.
SOURCE_WEIGHT_ARXIV=1.40
SOURCE_WEIGHT_GITHUB=1.20
SOURCE_WEIGHT_HACKER_NEWS=0.85
SOURCE_WEIGHT_RSS=1.00
SOURCE_WEIGHT_X=1.10
SOURCE_WEIGHT_BILIBILI=1.00
SOURCE_WEIGHT_DEFAULT=1.00
# Adds a multiplier for a configured authoritative author. 0.65 means +65%.
AUTHORITY_AUTHOR_BONUS=0.65
HEAT_FRESHNESS_WEIGHT=1.00
HEAT_ENGAGEMENT_WEIGHT=1.00

# Comma-separated public-author allowlists. X collection also needs X_BEARER_TOKEN.
X_AUTHOR_USERNAMES=
BILIBILI_AUTHOR_MIDS=
# Optional trusted display names used for any source platform.
TRUSTED_AUTHOR_NAMES=
